  "safe_filenames": [
    {
      "inp": "",
      "out": "unnamed"
    },
    {
      "inp": "plain.txt",
      "out": "plain.txt"
    },
    {
      "inp": "a/b",
      "out": "a_b"
    },
    {
      "inp": "a\\b",
      "out": "a_b"
    },
    {
      "inp": "a:b*c?d\"e<f>g|h",
      "out": "a_b_c_d_e_f_g_h"
    },
    {
      "inp": "___x___",
      "out": "x"
    },
    {
      "inp": "trailing...   ",
      "out": "trailing"
    },
    {
      "inp": ".hidden",
      "out": "_.hidden"
    },
    {
      "inp": "CON",
      "out": "_CON"
    },
    {
      "inp": "con.txt",
      "out": "_con.txt"
    },
    {
      "inp": "LPT1.dat",
      "out": "_LPT1.dat"
    },
    {
      "inp": "NUL",
      "out": "_NUL"
    },
    {
      "inp": "ok name .txt",
      "out": "ok name .txt"
    },
    {
      "inp": "a__b__c",
      "out": "a_b_c"
    },
    {
      "inp": ".txt",
      "out": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.txt"
    },
    {
      "inp": "한글 파일명.txt",
      "out": "한글 파일명.txt"
    },
    {
      "inp": "semi;colon",
      "out": "semi;colon"
    },
    {
      "inp": "under_score_",
      "out": "under_score"
    },
    {
      "inp": "_lead",
      "out": "lead"
    },
    {
      "inp": "dot.",
      "out": "dot"
    }
  ],
